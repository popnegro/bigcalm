BIGCALM_MQTT_URL=wss://broker.example.com/mqtt
# Or use private Render service discovery:
# BIGCALM_MQTT_HOST=bigcalm-mqtt-broker
# BIGCALM_MQTT_PORT=10000
BIGCALM_MQTT_USERNAME=
BIGCALM_MQTT_PASSWORD=
BIGCALM_MQTT_TOPIC=bigcalm/+/telemetry
BIGCALM_MQTT_CLIENT_ID=bigcalm-bridge
BIGCALM_MQTT_PROTOCOL_VERSION=4
BIGCALM_API_URL=https://your-bigcalm-domain.example
BIGCALM_INGEST_TOKEN=
PORT=10000
